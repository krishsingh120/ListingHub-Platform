# Server Configuration
PORT=8088
ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL Database Connection
# Format: postgres://username:password@localhost:5432/database_name?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/olx_dev?sslmode=disable

# Authentication
JWT_KEY=your-super-secret-jwt-key-min-32-chars

# Cloudflare R2 / AWS S3 Compatible Storage
STORAGE_ACCOUNT_ID=your_cloudflare_account_id
STORAGE_ACCESS_KEY=your_r2_access_key_id
STORAGE_ACCESS_SECRET=your_r2_secret_access_key
BUCKET=olx-listings-bucket
